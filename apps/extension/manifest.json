{
  "manifest_version": 3,
  "name": "Valinhall Security Extension",
  "version": "1.0.0",
  "description": "Browser extension for Valinhall: directly manipulates the DOM for LLM prompt testing and guardrails testing.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "index.html"
  }
}
