{
  "name": "valinhall",
  "version": "0.1.0",
  "private": true,
  "description": "AI-Assisted Automated Security Testing Tool",
  "scripts": {
    "dev": "pnpm --filter @valinhall/dashboard dev",
    "build": "pnpm --filter @valinhall/dashboard build",
    "preview": "pnpm --filter @valinhall/dashboard preview",
    "cli:build": "cargo build --manifest-path apps/cli/Cargo.toml --release",
    "cli:dev": "cargo run --manifest-path apps/cli/Cargo.toml --",
    "cli:test": "cargo test --manifest-path apps/cli/Cargo.toml",
    "lint": "pnpm --recursive run lint",
    "type-check": "pnpm --recursive run check"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}